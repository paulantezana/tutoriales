# GptLuna (API compatible con OpenAI)
GPTLUNA_BASE_URL=https://api.gptluna.com/v1
GPTLUNA_API_KEY=tu_api_key
GPTLUNA_MODEL=gptluna-chat

# Ollama (embeddings)
